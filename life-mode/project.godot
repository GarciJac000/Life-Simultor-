; LIFE//MODE — Milestone 1. Target editor: Godot 4.7.2 stable.
config_version=5

[application]
config/name="LIFE//MODE"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]
WorldClock="*res://scripts/autoload/world_clock.gd"
GameState="*res://scripts/autoload/game_state.gd"
EconomySystem="*res://scripts/autoload/economy_system.gd"
SimulationSystem="*res://scripts/autoload/simulation_system.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
environment/defaults/default_clear_color=Color(0.45, 0.55, 0.62, 1)

[physics]
common/physics_ticks_per_second=60

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}

move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}

move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}

sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}

interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}

map={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":77)]
}

phone={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194306)]
}

pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

debug_overlay={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194334)]
}
